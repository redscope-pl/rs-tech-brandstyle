{
  "$comment": "The one source of the RedScope Technologies style. scripts/build.py turns it into CSS variables (--rs-<group>-<name>); tests/check.py checks contrast. Brand colours were sampled from the logo (src/logo/redscope-tech-logo.source.png).",
  "brand": {
    "red": "#b11020",
    "red-deep": "#8a0c19",
    "night": "#160100",
    "white": "#ffffff"
  },
  "light": {
    "bg": "#fbf8f6",
    "surface": "#ffffff",
    "fg": "#2b2523",
    "muted": "#6f5f5a",
    "line": "#eadfda",
    "accent": "#b11020",
    "accent-hover": "#8a0c19",
    "accent-fg": "#ffffff",
    "accent-soft": "#fbe9e7"
  },
  "dark": {
    "bg": "#160100",
    "surface": "#1c0a0a",
    "fg": "#f2e9e7",
    "muted": "#a8948f",
    "line": "#3a2422",
    "accent": "#f2444f",
    "accent-hover": "#ff6b74",
    "accent-fg": "#160100",
    "accent-soft": "#3a1215"
  },
  "font": {
    "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", sans-serif",
    "mono": "ui-monospace, \"SFMono-Regular\", \"JetBrains Mono\", Menlo, Consolas, monospace"
  },
  "radius": {
    "sm": "0.3rem",
    "md": "0.75rem"
  },
  "contrast": {
    "$comment": "Pairs that must reach WCAG AA (4.5:1) in both schemes; checked by tests/check.py.",
    "pairs": [["fg", "bg"], ["fg", "surface"], ["muted", "bg"], ["muted", "surface"], ["accent", "bg"], ["accent", "surface"], ["accent-fg", "accent"]]
  }
}
