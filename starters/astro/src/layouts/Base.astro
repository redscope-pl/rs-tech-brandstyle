---
// The page frame in the RedScope style (rs-tech-brandstyle @@RS_VERSION@@).
// The brand's files are in public/brand/.
const { title = "RedScope Technologies" } = Astro.props;
const brand = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}brand`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<link rel="icon" href={`${brand}/icons/favicon.ico`}>
<link rel="apple-touch-icon" href={`${brand}/icons/icon-180.png`}>
<link rel="stylesheet" href={`${brand}/css/zone.css`}>
</head>
<body>
<main>
  <img class="brand" src={`${brand}/images/logo/mark.svg`} alt="RedScope Technologies">
  <slot />
  <footer class="muted">© RedScope Technologies</footer>
</main>
</body>
</html>
